# Canonical site URL (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://lalitgautam.com

# --- Form delivery (server-only, read at request time) ---
# Destination inbox for all inquiries, requests, and form submissions
INQUIRY_INBOX_EMAIL=lalit@sensegrass.com

# Direct Email Delivery via Resend (re_...) — RECOMMENDED:
# Get free API key from https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=
# NOTE: While using Resend's default sender (onboarding@resend.dev), Resend ONLY permits
# sending to the email address registered on your Resend account.
# To send to any recipient (e.g. lalit@sensegrass.com), verify your domain at
# https://resend.com/domains and set RESEND_FROM_EMAIL to your domain address.
RESEND_FROM_EMAIL=

# Optional: Webhook URL (Zapier, Make, Slack, or custom CRM endpoint)
INQUIRY_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>"
INQUIRY_WEBHOOK_SECRET=

# Public contact email (defaults to lalit@sensegrass.com)
NEXT_PUBLIC_CONTACT_EMAIL=lalit@sensegrass.com

# --- External links (inlined at build time; leave blank to hide) ---
# When set, "Book on Topmate" replaces the built-in "Request this call" dialog.
NEXT_PUBLIC_TOPMATE_URL=
NEXT_PUBLIC_BOOK_URL=
NEXT_PUBLIC_BOOK_SAMPLE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_WHATSAPP_URL=
