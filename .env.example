# Canonical site URL (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://lalitnewwebsitepinkcity.vercel.app

# --- Form delivery (server-only, read at request time) ---
# --- Database: every form submission is saved here (MongoDB via Mongoose) ---
# Free cluster: https://www.mongodb.com/cloud/atlas (M0). In Atlas → Network Access,
# allow 0.0.0.0/0 for Vercel. Without MONGODB_URI, submissions are only emailed.
MONGODB_URI=
# Optional: database name (otherwise the one in the URI, or "test")
MONGODB_DB=lalitgautam
# Private token for GET /api/inquiries (list submissions). Use a long random string.
INQUIRY_ADMIN_TOKEN=
# Optional: salt for hashing visitor IPs stored with each submission
INQUIRY_IP_SALT=

# Destination inbox(es) for all inquiries, requests and form submissions.
# Comma-separated; every address receives each submission. Invalid entries are ignored.
# Unset → lalit@sensegrass.com and glalit52@gmail.com.
INQUIRY_INBOX_EMAIL=lalit@sensegrass.com,glalit52@gmail.com

# Direct Email Delivery via Resend (re_...) — RECOMMENDED:
# Get free API key from https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=
# NOTE: While using Resend's default sender (onboarding@resend.dev), Resend ONLY permits
# sending to the email address registered on your Resend account.
# With two inbox recipients above, that means the send FAILS until a domain is verified:
# verify your domain at https://resend.com/domains and set RESEND_FROM_EMAIL to an address
# on it (e.g. "Lalit Gautam Website <hello@lalitgautam.com>").
RESEND_FROM_EMAIL=

# Optional: Webhook URL (Zapier, Make, Slack, or custom CRM endpoint)
INQUIRY_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>"
INQUIRY_WEBHOOK_SECRET=

# Public contact email (defaults to lalit@sensegrass.com)
NEXT_PUBLIC_CONTACT_EMAIL=lalit@sensegrass.com

# --- External links (inlined at build time; leave blank to hide) ---
# When set, "Book on Topmate" replaces the built-in "Request this call" dialog.
NEXT_PUBLIC_TOPMATE_URL=
NEXT_PUBLIC_BOOK_URL=
NEXT_PUBLIC_BOOK_SAMPLE_URL=
# Social profiles: each one set adds a logo button to the footer after the email pill,
# in the order Facebook, X, WhatsApp, Instagram, YouTube, LinkedIn (then Topmate).
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
# e.g. https://wa.me/<country code + number>
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
